# project/.gitignore

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/wheels/
*.egg-info/
.installed.cfg
*.egg

# Virtual Environments
venv/
ENV/
env/
.env

# Environments files (sensitive data)
.env.dev
.env.prod
!.env.example

# Databases
*.sqlite3
*.db

# Media and Static
project/media/
project/staticfiles/

# Logs
*.log
logs/

# IDEs and Editors
.visualstudio
.vscode/
.idea/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# OS files
.DS_Store
Thumbs.db

usage.md