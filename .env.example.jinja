# -----------------------------------------------------------------------------
# Django Core
# -----------------------------------------------------------------------------
DEBUG=True #or False if you want to run the project in production mode
SECRET_KEY=
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CSRF_TRUSTED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# -----------------------------------------------------------------------------
# Database (PostgreSQL)
# -----------------------------------------------------------------------------
POSTGRES_DB={{ project_slug }}_db
POSTGRES_USER={{ project_slug }}_db_user
POSTGRES_PASSWORD=change-me-dev
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgres://{{ project_slug }}_db_user:change-me-dev@db:5432/{{ project_slug }}_db

# -----------------------------------------------------------------------------
# Redis & Cache
# -----------------------------------------------------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://redis:6379/1

# -----------------------------------------------------------------------------
# Nginx / Web Network
# -----------------------------------------------------------------------------
NGINX_PORT=port-example

# -----------------------------------------------------------------------------
# Django Security & Runtime Setup
# -----------------------------------------------------------------------------
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
DJANGO_COLLECTSTATIC=True
DJANGO_LOG_LEVEL=DEBUG

# -----------------------------------------------------------------------------
# Static & Media Paths
# -----------------------------------------------------------------------------
DJANGO_STATIC_URL=/static/
DJANGO_MEDIA_URL=/media/

# -----------------------------------------------------------------------------
# Localization & Email Debug
# -----------------------------------------------------------------------------
TIME_ZONE=Europe/Rome
LANGUAGE_CODE=it-it
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend