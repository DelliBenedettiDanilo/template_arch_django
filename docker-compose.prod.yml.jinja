x-logging: &default-logging
  driver: json-file
  options:
    max-size: "10m"
    max-file: "3"

services:
  db:
    image: postgres:15-alpine
    restart: always
    env_file:
      - .env.prod
    volumes:
      - "{{ project_slug }}_postgres_data:/var/lib/postgresql/data"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U ${POSTGRES_USER} -d ${POSTGRES_DB}"]
      interval: 10s
      timeout: 5s
      retries: 5
    logging: *default-logging

  redis:
    image: redis:7-alpine
    restart: always
    command: redis-server --appendonly yes
    volumes:
      - "{{ project_slug }}_redis_data:/data"
    healthcheck:
      test: ["CMD", "redis-cli", "ping"]
      interval: 5s
      timeout: 3s
      retries: 3
    logging: *default-logging

  web:
    # Approccio "registry": l'immagine è costruita e pubblicata dalla pipeline CI
    # (job build-and-push in .github/workflows/cd.yml) su GHCR, poi scaricata qui
    # con `docker compose pull`. WEB_IMAGE viene esportata dallo step di deploy
    # della CD con il tag dell'immagine appena pubblicata (es. lo SHA del commit).
    # Sostituisci "tuo-utente/prova" con l'owner/repo reale su GitHub.
    #image: ${WEB_IMAGE:-ghcr.io/tuo-utente/prova:latest}
    # Blocco originale, usato per build locale (es. in dev o per test manuali):
    build:
      context: .
      dockerfile: Dockerfile
    restart: always
    env_file:
      - .env.prod
    working_dir: /app/project
    volumes:
      - "{{ project_slug }}_static:/app/staticfiles"
      - "{{ project_slug }}_media:/app/mediafiles"
    expose:
      - "8000"
    depends_on:
      db:
        condition: service_healthy
      redis:
        condition: service_healthy
    healthcheck:
      test: ["CMD", "python", "-c", "import urllib.request; urllib.request.urlopen('http://localhost:8000/healthz/', timeout=3)"]
      interval: 15s
      timeout: 5s
      retries: 5
      start_period: 20s
    logging: *default-logging

  nginx:
    image: nginx:alpine
    restart: always
    ports:
      - "${NGINX_PORT:-80}:80"
    volumes:
      - ./nginx/prod.conf:/etc/nginx/conf.d/default.conf:ro
      - "{{ project_slug }}_static:/app/staticfiles:ro"
      - "{{ project_slug }}_media:/app/mediafiles:ro"
    depends_on:
      - web
    logging: *default-logging

  backup:
    image: postgres:15-alpine
    restart: always
    env_file:
      - .env.prod
    volumes:
      - "{{ project_slug }}_backups:/backups"
      - ./scripts/backup.sh:/backup.sh:ro
    entrypoint: ["/bin/sh", "/backup.sh"]
    depends_on:
      db:
        condition: service_healthy
    logging: *default-logging

volumes:
  "{{ project_slug }}_postgres_data":
  "{{ project_slug }}_redis_data":
  "{{ project_slug }}_static":
  "{{ project_slug }}_media":
  "{{ project_slug }}_backups":